<?xml version="1.0" encoding="UTF-8"?>

<!--
  Discodeit Logback 설정

  application-<profile>.yml:
    로거별 출력 레벨 관리

  logback-spring.xml:
    로그 출력 위치, 형식, 롤링 정책 관리
-->
<configuration>

    <!-- Spring Boot의 Logback 기본 변환 규칙을 사용한다. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      LOG_PATH 환경변수가 있으면 해당 경로를 사용한다.
      없으면 프로젝트 실행 경로의 .logs 디렉터리를 사용한다.

      절대 경로 예시:
      LOG_PATH=D:/discodeit/logs
    -->
    <springProperty
            scope="context"
            name="LOG_DIR"
            source="LOG_PATH"
            defaultValue=".logs"
    />

    <!-- application.yml의 logging.level.root 값을 가져온다. -->
    <springProperty
            scope="context"
            name="ROOT_LOG_LEVEL"
            source="logging.level.root"
            defaultValue="INFO"
    />

    <!-- 현재 작성 중인 로그 파일 -->
    <property
            name="LOG_FILE"
            value="${LOG_DIR}/discodeit.log"
    />

    <!--
      요구사항에 맞춘 공통 로그 패턴

      날짜/시간 [스레드] 로그레벨 로거명 - 메시지
    -->
    <property
            name="LOG_PATTERN"
            value="%d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"
    />

    <!-- 콘솔 로그 출력 -->
    <appender
            name="CONSOLE"
            class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 개발 및 운영 환경에서 사용하는 파일 로그 -->
    <springProfile name="dev | prod">

        <!-- 날짜와 파일 크기를 기준으로 로그 파일을 분리한다. -->
        <appender
                name="FILE"
                class="ch.qos.logback.core.rolling.RollingFileAppender">

            <!-- 현재 날짜에 기록되는 활성 로그 파일 -->
            <file>${LOG_FILE}</file>

            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>

            <!--
              날짜가 변경되거나 파일이 10MB를 초과하면 롤링한다.
              롤링된 파일은 gzip 형식으로 압축한다.
            -->
            <rollingPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

                <fileNamePattern>
                    ${LOG_DIR}/discodeit.%d{yyyy-MM-dd}.%i.log.gz
                </fileNamePattern>

                <!-- 개별 로그 파일의 최대 크기 -->
                <maxFileSize>10MB</maxFileSize>

                <!-- 일자 기준 최대 30일 보관 -->
                <maxHistory>30</maxHistory>

                <!-- 보관 중인 전체 로그 파일 크기 제한 -->
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

    </springProfile>

    <!-- 개발 환경: 콘솔과 파일에 함께 출력 -->
    <springProfile name="dev">
        <root level="${ROOT_LOG_LEVEL}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- 운영 환경: 콘솔과 파일에 함께 출력 -->
    <springProfile name="prod">
        <root level="${ROOT_LOG_LEVEL}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- 테스트 환경: 콘솔에만 출력 -->
    <springProfile name="test">
        <root level="${ROOT_LOG_LEVEL}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>