# Docker Compose 실행 전 이 파일을 .env로 복사하세요.
# cp .env.example .env
# 아래 값을 설정한 뒤 앱·DB·Redis를 함께 실행하세요.
# docker compose up -d
# PostgreSQL·Redis만 수동으로 실행하려면:
# docker compose up -d postgres redis

# 애플리케이션
PROJECT_NAME=discodeit
PROJECT_VERSION=1.2-M8
JVM_OPTS=-Xms200m -Xmx400m
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=80
ADMIN_USER_NAME=change-me
ADMIN_USER_PASSWORD=change-me
ADMIN_USER_EMAIL=admin@discodeit.local

# JWT 저장소: in-memory 또는 redis
# 여러 앱 인스턴스가 로그인 정보를 공유하려면 redis로 설정하세요.
JWT_REGISTRY_TYPE=in-memory
# 사용자별로 동시에 유지할 최대 로그인 세션 수(1 이상의 정수)
JWT_MAX_ACTIVE_JWT_COUNT=1
# JWT 서명용 비밀값을 무작위로 생성해 최소 32바이트 이상으로 설정하세요.
# 빈 값으로 두면 애플리케이션을 시작할 수 없습니다.
JWT_SECRET=
JWT_ACCESS_TOKEN_VALIDITY=10m
JWT_REFRESH_TOKEN_VALIDITY=14d
JWT_ISSUER=discodeit

REFRESH_COOKIE_HTTP_ONLY=true
# HTTPS 운영 환경에서는 true를 사용하고, HTTP 로컬 검증 시에만 false로 변경하세요.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=lax

# 데이터베이스
POSTGRES_HOST_PORT=5434
DB_HOST=postgres
DB_PORT=5432
DB_NAME=discodeit
DB_USERNAME=discodeit_user
DB_PASSWORD=change-me

# Redis 연결
# 앱 컨테이너에서는 같은 네트워크의 Redis 서비스 이름을 사용합니다.
# 앱을 호스트에서 직접 실행할 때는 REDIS_HOST=localhost를 환경변수로 설정하세요.
REDIS_HOST=redis
REDIS_PORT=6379

# 파일 저장소
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=.discodeit/storage
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket-name
# 로컬 S3 호환 서버를 사용할 때만 지정하고, 실제 AWS S3 사용 시 비워 두세요.
AWS_S3_ENDPOINT=
AWS_S3_PRESIGNED_URL_EXPIRATION=600

# 알림 비동기 실행기: 기본 스레드 수, 최대 스레드 수, 대기열 용량, 유휴 스레드 유지 시간
DISCODEIT_ASYNC_NOTIFICATION_COREPOOLSIZE=2
DISCODEIT_ASYNC_NOTIFICATION_MAXPOOLSIZE=4
DISCODEIT_ASYNC_NOTIFICATION_QUEUECAPACITY=32
DISCODEIT_ASYNC_NOTIFICATION_KEEPALIVE=60s

# 파일 업로드 비동기 실행기: 기본 스레드 수, 최대 스레드 수, 대기열 용량, 유휴 스레드 유지 시간
DISCODEIT_ASYNC_FILEUPLOAD_COREPOOLSIZE=2
DISCODEIT_ASYNC_FILEUPLOAD_MAXPOOLSIZE=4
DISCODEIT_ASYNC_FILEUPLOAD_QUEUECAPACITY=4
DISCODEIT_ASYNC_FILEUPLOAD_KEEPALIVE=60s

# 공통 설정
TZ=Asia/Seoul
